#=========================================================================#
# Custom Jolkr upload template (port 443)
#
# Upload-only subdomain: only the two attachment endpoints are proxied to
# the backend, everything else is 404. The nginx.ssl.conf_* include at the
# bottom carries Hestia's LE http-01 token block, needed when validation
# follows the http->https redirect.
#=========================================================================#
server {
    listen      %ip%:%proxy_ssl_port% ssl;
    server_name %domain_idn% %alias_idn%;
    error_log   /var/log/apache2/domains/%domain%.error.log error;
    access_log  /var/log/apache2/domains/%domain%.log combined;
    access_log  /var/log/apache2/domains/%domain%.bytes bytes;

    ssl_certificate     %ssl_pem%;
    ssl_certificate_key %ssl_key%;
    ssl_stapling        on;
    ssl_stapling_verify on;

    # Body limit — accommodates MAX_FILE_SIZE 250MB + multipart overhead.
    client_max_body_size 300M;
    client_body_buffer_size 128k;

    # Stream uploads directly to backend; no on-disk buffering.
    # proxy_request_buffering off;

    # Long-running uploads (250MB on a slow connection).
    proxy_read_timeout 600;
    proxy_send_timeout 600;
    proxy_connect_timeout 30;

    include /home/%user%/conf/web/%domain%/nginx.hsts.conf*;

    # Lock down dotfiles. The negative lookahead keeps /.well-known
    # reachable so the ACME challenge below is not blocked.
    location ~ /\.(?!well-known) { deny all; return 404; }

    # Allow ONLY the two attachment endpoints. Everything else → 404.
    # POST /api/channels/<uuid>/messages/<uuid>/attachments
    # POST /api/dms/<uuid>/messages/<uuid>/attachments
    location ~ ^/api/(channels|dms)/[a-zA-Z0-9-]+/messages/[a-zA-Z0-9-]+/attachments$ {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass https://192.168.178.22$request_uri;
    }

    # Jolkr error pages — per-vhost override of the http-level map in nginx.conf.
    # proxy_intercept_errors stays off: upstream errors keep their own body.
    error_page 400 /error/400.html;
    error_page 401 /error/401.html;
    error_page 403 /error/403.html;
    error_page 404 /error/404.html;
    error_page 410 /error/410.html;
    error_page 413 /error/413.html;
    error_page 429 /error/429.html;
    error_page 500 /error/500.html;
    error_page 502 /error/502.html;
    error_page 503 /error/503.html;
    error_page 504 /error/504.html;
    error_page 501 505 /error/50x.html;

    # Error documents. `internal` keeps them reachable only via error_page,
    # so the upload-only allowlist is not widened.
    location /error/ {
        internal;
        alias /home/%user%/web/%domain%/document_errors/;
    }

    # Hard-deny everything else; this subdomain is upload-only.
    location / { return 404; }

    # Hestia LE http-01 token (regex location, evaluated before location /).
    include /home/%user%/conf/web/%domain%/nginx.ssl.conf_*;
}
